    margin-top: auto;
    padding-top: 8px;
}

.imdb-link-btn {
    display: inline-block;
    text-decoration: none;
    font-family: 'OpenSans_SemiBold', sans-serif;
    background-color: #6C1C6D; 
    padding: 10px 18px;
    border-radius: 6px;
