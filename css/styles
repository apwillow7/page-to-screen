/* ANTICIPATED ADAPTATIONS */

.disclaimer {
    text-align: center;
    font-size: 20px;
    margin: 20px 0;
    font-family: 'OpenSans-SemiBoldItalic', sans-serif;
}

p.anticipated_description {
    margin: 20px 0;
    font-size: 18px;
    font-family: 'OpenSans_Regular', sans-serif;
    line-height: 1.5;
    text-align: center;
}

.database_grid_container {
    display: flex;
    flex-direction: column;
    gap: 12px; 
    max-width: 1600px;
    margin: 30px auto;
    padding: 0 clamp(16px, 2.5vw, 40px);
    box-sizing: border-box;
    font-family: 'OpenSans_Regular', sans-serif;
}

.grid_row {
    display: grid;
    grid-template-columns: 2.6fr 1.6fr 1.3fr 1.4fr 1.9fr 1.4fr 1.4fr;
    gap: 16px;
    padding: 15px 20px;
    align-items: center;
    justify-items: center;
    text-align: center;
}

.grid_row > div,
.grid_row > span {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-width: 0;
}

.date_cell {
    padding-left: 10px;
    padding-right: 10px;
    white-space: normal;
    word-break: break-word;
    justify-content: center;
}

.genre_cell {
    padding-left: 10px;
    padding-right: 10px;
    white-space: normal;
    word-break: break-word;
    justify-content: center;
}

.header_row {
    font-family: 'OpenSans_SemiBold', sans-serif;
    font-weight: 600;
    color: #6C1C6D;
    border-bottom: 2px solid #000000;
    font-size: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.data_row {
    background-color: #F9F9F9;
    border-radius: 6px;
    border-left: 4px solid #6C1C6D;
    font-size: 15px;
    transition: transform 0.2s ease;
    align-items: center;
    justify-items: center;
    text-align: center;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px 16px;
}

.data_row > div:nth-child(1) {
    grid-column: 1;
}

.data_row > div:nth-child(2) {
    grid-column: 2;
}

.data_row > div:nth-child(3) {
    grid-column: 3;
}

.data_row > .status_badge {
    grid-column: 4;
}

.data_row > div:nth-child(5) {
    grid-column: 1;
}

.data_row:hover {
    transform: translateY(-2px);
    background-color: #F1F1F1;
}

.book_title {
    font-family: 'OpenSans_SemiBold', sans-serif;
    font-weight: 600;
}

.cell {
    font-size: 16px;
    padding: 0 5px;
    display: flex !important;
    align-items: center !important;
    margin: 0 !important;
}

    .cell span {
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    display: inline-block;
}

    .title_cell {
        font-weight: bold;
}

.status_badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
    min-width: 110px;
}

.badge_green { 
    color: #065F46; 
    background-color: #D1FAE5; 
}/* Green: Post-Production / Done Filming */


.badge_yellow { 
    color: #856404; 
    background-color: #FFF3CD; 
}/* Yellow: Filming / Active Production */


.badge_orange { 
    color: #A44C00; 
    background-color: #FFE8D6; 
}/* Orange: Pre-Production / Announced */


.badge_red { 
    color: #B80404; 
    background-color: #FCE8E6; 
}/* Red: In Development */

/* SUBMISSION FORM */

.form_page_wrapper {
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 200px); 
}

.form_container {
    background-color: #1E1F22; 
    width: 100%;
    max-width: 650px;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    font-family: 'OpenSans_Regular', sans-serif;
}

.form_title {
    font-family: 'BebasNeue', sans-serif;
    font-size: 36px;
    color: #FFFFFF;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.form_subtitle {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 15px;
    color: #d5d8e1;
    line-height: 1.5;
    margin-bottom: 30px;
    text-align: center;
}

.form_group {
    margin-bottom: 22px;
    display: flex;
    flex-direction: column;
}

.form_row .form_group {
    flex: 1;
}

.form_row {
    display: flex;
    gap: 20px;
    flex-wrap: wrap; 
}

.form_group label {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 8px;
}

.required {
    color: #A8FFF9; 
}

.optional {
    color: #A0A5B5;
    font-size: 12px;
    font-weight: normal;
}

.native_submission_form input[type="text"],
.native_submission_form input[type="url"],
.native_submission_form select,
.native_submission_form textarea {
    background-color: #121214;
    border: 2px solid #2B2D31;
    border-radius: 6px;
    color: #FFFFFF;
    padding: 12px 16px;
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 15px;
    outline: none;
    transition: all 0.2s ease-in-out;
}


.native_submission_form select {
    cursor: pointer;
    appearance: none; 
}

.native_submission_form input:focus,
.native_submission_form select:focus,
.native_submission_form textarea:focus {
    border-color: #A8FFF9;
    box-shadow: 0 0 8px rgba(168, 255, 249, 0.2);
}

.submit_btn {
    background-color: #6C1C6D; 
    color: #FFFFFF;
    font-family: 'BebasNeue', sans-serif;
    font-size: 22px;
    letter-spacing: 1px;
    border: none;
    border-radius: 6px;
    padding: 14px;
    width: 100%;
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.2s ease;
}

.submit_btn:hover {
    background-color: #FFFFFF; 
    transform: translateY(-2px); 
    box-shadow: 0 5px 15px rgba(168, 255, 249, 0.3);
}

/* CONTACT SUBMISSION FORM */

.contact_form_wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 60px 20px;
    min-height: 70vh;
}

.contact_form_subtitle {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 15px;
    color: #d5d8e1;
    line-height: 1.5;
    margin-bottom: 30px;
    text-align: center;
}

.submit_form_button {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 15px;
    color: #A8FFF9;
    line-height: 1.5;
    margin-bottom: 30px;
    text-align: center;
    list-style: none;
    text-decoration: underline;

}

.contact_form_container {
    background-color: #1E1F22;
    padding: 40px;
    border-radius: 8px;
    width: 100%;
    max-width: 650px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.contact_form_container h2 {
    font-family: 'BebasNeue', sans-serif; 
    letter-spacing: 1px;
    margin-top: 0;
    margin-bottom: 24px;
    color: #FFFFFF; 
}

.contact_form_row {
    display: flex;
    gap: 20px;
    flex-wrap: wrap; 
}

.contact_form_group {
    margin-bottom: 20px;
    flex: 1; 
    min-width: 250px;
}

form > .contact_form_group {
    width: 100%;
}

.contact_form_group label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #FFFFFF; 
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 14px;
}

.contact_form_group input,
.contact_form_group textarea {
    background-color: #2A2B2F; 
    border: 1px solid #3A3B3F;
    border-radius: 4px;
    padding: 12px 14px;
    color: #FFFFFF;
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 15px;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}


.contact_form_group textarea {
    height: 160px;
    resize: vertical; 
}

.contact_form_group input:focus,
.contact_form_group textarea:focus {
    outline: none;
    border-color: #A8FFF9; 
    box-shadow: 0 0 8px rgba(168, 255, 249, 0.4);
}

.send_btn {
    background-color: #6C1C6D; 
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 14px 28px;
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 0.5px;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
    transition: background-color 0.3s ease, color 0.3s ease;
}

.send_btn:hover {
    background-color: #A8FFF9; 
    color: #121214; 
}

