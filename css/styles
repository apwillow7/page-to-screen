/* ============================================================================
   FONTS
   ============================================================================ */

@font-face {
    font-family: 'OpenSans_Regular';
    src: url('Fonts/OpenSans-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'OpenSans_SemiBold';
    src: url('Fonts/OpenSans-SemiBold.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'OpenSans-SemiBoldItalic';
    src: url('Fonts/OpenSans-SemiBoldItalic.ttf') format('truetype');
    font-weight: normal;
    font-style: italic;
    font-display: swap;
}

@font-face {
    font-family: 'OpenSans_Bold';
    src: url('Fonts/OpenSans-Bold.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'BebasNeue';
    src: url('Fonts/BebasNeue-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

/* ============================================================================
   UTILITY CLASSES
   ============================================================================ */

.clearfix::after {
    visibility: hidden;
    display: block;
    font-size: 0;
    content: " ";
    clear: both;
    height: 0;
}

.clearfix {
    display: block;
}

* html .clearfix {
    height: 1%;
}

/* ============================================================================
   BASE TYPOGRAPHY & LAYOUT
   ============================================================================ */

html,
body {
    margin: 0;
    padding: 0;
}

body {
    font-family: 'OpenSans_Regular', sans-serif;
    color: #121214;
    background-color: #ffffff;
}

img,
iframe,
video {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

.logo_icon {
    width: 80px;
    height: 80px;
    flex: 0 0 80px;
    object-fit: contain;
    padding: 6px;
    box-sizing: border-box;
}

/* ============================================================================
   NAVIGATION
   ============================================================================ */

.site_nav {
    background-color: #6C1C6D; 
    padding: 15px clamp(20px, 3vw, 64px);
    display: flex;
    justify-content: space-between; 
    align-items: center;
    list-style: none;
}
.site_nav ul {
    list-style: none;
    display: flex;
    gap: 25px;
    margin: 0;
    padding: 0;
}
.site_nav ul li {
    display: inline;
}


.site_nav .logo_group {
    display: flex;
    align-items: center;
    gap: 14px;
    color: inherit;
}

.site_nav .profile_img {
    width: 85px !important;
    height: 85px !important;
    border-radius: 50% !important; 
    object-fit: cover !important;  
    border: 2px solid #A8FFF9 !important; 
}

.site_nav h1 {
    margin: 0;
    font-size: 45px;
    font-family: 'BebasNeue';
    color: #A8FFF9;
    letter-spacing: 1px;
}

@media (max-width: 600px) {
    .logo_icon {
        width: 48px;
        height: 48px;
        flex-basis: 48px;
    }

    .site_nav .logo_group {
        gap: 9px;
    }

    .site_nav h1 {
        font-size: 32px;
    }
}

.menu_checkbox {
    display: none; 
}

.menu_button {
    display: flex;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    padding: 10px;
    z-index: 100; 
}

.hamburger_line {
    display: block;
    width: 30px;
    height: 3px;
    background-color: #A8FFF9; 
    border-radius: 2px;
    transition: all 0.3s ease;
}

.nav_link {
    font-family: 'BebasNeue';
    color: #FFFFFF;
    text-decoration: none;
    font-size: 24px;
    letter-spacing: 1px;
    transition: color 0.2s ease;
}

.main_nav_sidebar ul li a:hover,
.main_nav_sidebar ul li a.active {
    color: #A8FFF9 !important;
}

.main_nav_sidebar ul li:has(script),
.of_date_main_nav_sidebar ul li:has(.bmc-btn-container),
.aa_main_nav_sidebar ul li:has(script) {
    display: flex !important;
    list-style: none;
    list-style-type: none;
    justify-content: flex-start;
    align-items: center;
    text-align: left;
    padding-left: 0;
    margin-left: 0;
}

.main_nav ul {
    list-style: none !important;
    list-style-type: none !important;
    display: flex !important;
    gap: 25px !important;
    margin: 0 !important;
    padding: 0 !important;
}

.bmc-btn-container, 
#bmc-wbtn-wrapper {
    text-align: left !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    justify-content: flex-start !important;
 }   

.main_nav ul li {
    list-style: none !important;
    list-style-type: none !important;
    display: inline-block !important;
}

.main_nav_sidebar {
    position: fixed;
    top: 0;
    right: -375px; 
    width: 375px;
    height: 100vh; 
    background-color: #6C1C6D; 
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.3);
    padding: 80px 30px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 999; 
}
.main_nav_sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
}
.main_nav_sidebar ul li a {
    font-family: 'OpenSans_Regular', sans-serif;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 22px;
    display: block;
}

.menu_checkbox:checked ~ .main_nav_sidebar {
    right: 0;
}

.nav_link:hover,
.nav_link.active {
    color: #A8FFF9; 
}

.close_button {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 40px;
    color: #A8FFF9;
    cursor: pointer;
}

.page_wrapper {
    max-width: 1800px;
    margin: 25px auto;
    padding: 0 clamp(16px, 2.5vw, 40px);
    box-sizing: border-box;
    line-height: 1.6;
}

.page_wrapper, main {
    margin-bottom: 25px !important; 
}

/* ============================================================================
   PAGE BODY
   ============================================================================ */

.welcome_title {
    font-size: 38px;
    font-family: 'BebasNeue', sans-serif;
    color: #6C1C6D;
    text-align: center;
    margin-bottom: 20px;
}

.welcome_message, .body_text, .navigate_list li, .data_list li {
    font-family: "area-normal", sans-serif;
    font-size: 18px;
    margin-bottom: 15px;
    text-align: center;
}

.welcome_message { text-align: center; }

.header_buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
    margin-top: 40px;

    list-style: none;
}

.button_container {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.btn {
  padding: 16px 24px;
  font-weight: 500;
  border-radius: 10px;
  cursor: pointer;
  border: none;
  list-style: none;
  text-decoration: none;
  font-family: "area-normal", sans-serif;
  font-weight: 700;
  font-style: normal; 
  }

.btn_primary { background-color: #6C1C6D; color: #ffffff; }
.btn_secondary { background-color: #6C1C6D; color: #ffffff; }

.btn_primary:hover,
.btn_secondary:hover,
.btn_link.active {
    color: #A8FFF9; 
}

@media (min-width: 600px) {
  .button_container {
    flex-direction: row; 
  }
}

.navigate_list, .data_list {
    list-style-type: none;
    padding: 0;
}

.navigate_list li, .data_list li {
    padding: 10px;
    border-bottom: 1px solid #eee;
}

.data_subtitle {
    font-family: "area-normal-bold", sans-serif;
    text-align: center;
    font-size: 18px;
    margin-bottom: 15px;
}

/* Recently Announced Dropped Trailers and Released Dates */

.feature_section {
  max-width: 1680px;
  margin: 40px auto;
  padding: 0 clamp(16px, 2.5vw, 40px);
  box-sizing: border-box;
}

.feature_section {
  color: #6C1C6D;
  font-weight: bold;
  margin-bottom: 20px;
  padding-bottom: 8px;
}

.card_grid.date_cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* Creates 3 equal columns */
  gap: 32px;
  align-items: start;
}

/* Ensures images scale nicely inside their containers */
.ad_card .content_media img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 8px; 
}

.card_grid.date_cards {
  display: flex;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap; 
}

.ad_card {
  flex: 1;
  min-width: 250px; 
}

.ad_card_title {
    font-family: "BebasNeue", sans-serif;
    font-size: 30px;
    color: #121214;
    margin: 6px 0px 2px 0; 
    line-height: 1.1;  
}

.announcement_media {
    display: flex;
    position: relative;
    padding: 20px 20px 0px 20px; 
}

.announcement_card {
    padding: 10px 10px 0 10px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 2px; 
    text-align: center;
}

.trailer_title {
    font-family: "BebasNeue", sans-serif;
    font-size: 30px;
    color: #121214;
    margin: 6px 0px 2px 0; 
    line-height: 1.1; 
}

.trailer_section {
    padding: 10px 10px 0 10px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 2px;
    text-align: center;
}

.date_cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.trailer_cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
}

.content_media {
  width: 100%;
  max-width: 200px;         
  aspect-ratio: 2 / 3;     
  margin: 0 auto;          
  overflow: hidden;        
  border-radius: 8px;    
  margin-bottom: 15px; 
  display: block;      
}

/* Image styling inside the container */
.content_media img {
  width: 100%;
  height: 100%;
  object-fit: cover;       
  object-position: center;  
  display: block;     
}

.announcement_card {
    text-align: center;
}

.feature_card {
  background: #ffffff;
  border: 1px solid #e2d5e8;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.feature_card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 16px rgba(76, 29, 93, 0.12);
}

.video_container {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  background: #000;
}

.video_container iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.card_author,
.card_rating,
.card_date {
  font-size: 14px;
  color: #121214;
  margin: 0 0 4px 0;
}

.date_badge {
  margin-top: auto;
  background: #6C1C6D;
  color: #ffffff;
  text-align: center;
  font-weight: bold;
  font-size: 14px;
  padding: 6px 10px;
  border-radius: 4px;
  letter-spacing: 0.5px;
}

/* ============================================================================
  HOW TO NAIL THE DATABASE GUIDE
   ============================================================================ */

/* Container holding both columns side-by-side */
.database_guide_wrapper {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    width: calc(100% - 48px);
    max-width: 1600px;
    margin: 48px auto 0;
    box-sizing: border-box;
    justify-self: center;
    align-items: stretch; 
}

.card_box {
    min-width: 0;
    background-color: #f8f9fa;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    height: 100%; 
    box-sizing: border-box;
}

/* Titles & Subtitles */
.section_title {
    font-size: 34px;
    font-family: 'BebasNeue', sans-serif;
    color: #6C1C6D;
    text-align: center;
    margin-bottom: 15px;
}

.section_intro,
.data_subtitle {
    font-size: 16px;
    color: #4a4a4a;
    margin-bottom: 24px;
    line-height: 1.5;
    text-align: center;
}

.navigate_list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between; 
    flex-grow: 1; /* Fills available card height */
}

.navigate_list li {
    font-size: 16px;
    line-height: 1.6;
    color: #333333;
}

.navigate_list strong {
    color: #111111;
}

/* Right Column List Styling (Balanced spacing) */
.data_list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10.4px; /* Tightened gap to align total height with left card */
    height: 100%;
}

.data_list li {
    font-size: 16px;
    line-height: 1.35; /* Adjusted line-height for compact rows */
    color: #333333;
}

.data_list strong {
    color: #111111;
}

/* Mobile Responsiveness: Stack columns vertically on smaller screens */
@media (max-width: 850px) {
    .database_guide_wrapper {
        grid-template-columns: 1fr; /* Single column layout for mobile/tablets */
        gap: 32px;
    }

    .card_box {
        padding: 28px;
        height: auto;
    }
}

/* FOOTER */

.site_footer a {
    color: #FFFFFF;
    font-size: 30px;
    text-decoration: none;
    font-family: 'BebasNeue';
}

.site_footer {
    background-color: #6C1C6D;
    padding: 30px 5%;
    display: flex;
    justify-content: space-between; 
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.footer_nav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 20px;
}
.footer_nav li a {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
}
.footer_nav li a:hover {
    color: #A8FFF9; 
}

.social_media_nav {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-right: 250px;
    display: flex;
    align-items: center;
}
.social_media_nav li {
    display: flex;
    align-items: center;
    gap: 8px;
}
.social_media_nav li i {
    color: #A8FFF9;
    font-size: 18px;
}
.social_media_nav li a {
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
}
.social_media_nav li a:hover {
    color: #A8FFF9; 
}

.instagram_icon {
    width: 20px !important;
    height: 20px !important;
    padding-right:0;
    margin:0px; 
    display: flex;
}

.email_icon {
    width: 20px !important;
    height: 20px !important;
    padding-right:0;
    margin:0px; 
    display: flex;
}

.last_updated {
    width: 100%; 
    text-align: center;
    color: #F5F5F7; 
    font-family: 'OpenSans_Regular', sans-serif;
    font-size: 14px;
    padding-top: 15px;
}

/* OFFICIAL DATES */

#november {
  scroll-margin-top: 80px; 
}

.page_header h1 {
    color: #6C1C6D;
}

.subtitle {
    font-size: 24px;
}

.adaptation_container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px clamp(16px, 2.5vw, 40px);
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
}

.page_header {
    text-align: center;
    margin-bottom: 40px;
}

/* ============================================================================
   SEARCH AND FILTER CONTROLS
   ============================================================================ */
   
/* Container Box */
.controls_section {
  display: flex;
  flex-direction: column;
  gap: 15px;
  color: #FFFFFF;
  padding: 15px;
  border-radius: 8px;
  align-items: center;
}

.search_container .controls_section {
  width: 75%;
  box-sizing: border-box;
}

.main_controls_row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.search_bar {
  flex: 1;
  min-width: 750px;
  color: #2B2D31;
  border: 1px solid #551556;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 14px;
  outline: none;
}

.filter_group {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.filter_btn {
  background-color:#DBDEE1 ;
  color:#2B2D31;
  border: 1px solid #3F4147;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  transition: all 0.2s ease;
}

.filter_btn:hover {
  background-color: #35373C;
  color: #FFFFFF;
}

.filter_btn.active {
  background-color: #551556;
  color: #FFFFFF;
} 

/* Toggle Button & Arrow Setup */
.toggle_filters_btn {
  color: #FFFFFF;
  background-color: #551556;
  border: 1px solid #551556;
  font-size: 14px;
  outline: none;
  padding: 6px 14px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.arrow_icon {
  font-size: 10px;
  display: inline-block; /* Essential for arrow transform rotation */
  transition: transform 0.3s ease;
}

/* Rotate arrow when button has .active class */
.toggle_filters_btn.active .arrow_icon {
  transform: rotate(180deg);
}

/* Collapsible Panel Styling */
.extra_filters_panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-top: 15px;
  border-top: 1px solid #3F4147;
}

/* FORCE CLOSE ON PAGE LOAD */
.extra_filters_panel.hidden {
  display: none !important;
}

.filter_row {
  display: flex;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
}

.category_label {
  font-size: 12px;
  font-weight: 600;
  color: #949BA4;
  min-width: 60px;
  text-transform: uppercase;
}

/* ============================================================================
   TIMELINE ACCORDION 
   ============================================================================ */

.timeline_accordion_group {
    display: flex;
    flex-direction: column;
    gap: 5px; 
}

.month_header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #121214; 
    cursor: pointer;
    list-style: none; 
    margin-bottom: 20px;
    border-radius: 6px;
}

.month_header::-webkit-details-marker {
    display: none;
}

.month_title {
    font-weight: bold;
    color: #ffffff;
    font-size: 20px;
}

.accordion_arrow {
    color: #A8FFF9; 
    font-size: 16px;
    display: inline-block; 
    transition: transform 0.3s ease;
}

details[open] .accordion_arrow {
    transform: rotate(180deg);
}


.adaptations_grid {
    display: grid;
  grid-template-columns: repeat(2, 1fr);
    /* This adds space between cards so they don't touch */
    gap: 20px; 
    justify-content: center;
}

@media (max-width: 900px) {
    .adaptations_grid {
        grid-template-columns: repeat(2, 1fr); 
    }
}

@media (max-width: 600px) {
    .adaptations_grid {
        grid-template-columns: 1fr; 
    }
}

.adaptation_card {
    display: flex;
    flex-direction: column;  
    background-color: #F5F5F7; 
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    max-width: 650px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    font-family: Arial, sans-serif;
    color: #ffffff;
}

.adaptation_card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
}

.adaptation_card .badge {
    text-decoration: none;
    display: inline-block;
    font-family: 'OpenSans_Bold', sans-serif;
    align-items: center;
    align-self: flex-start;
    width: fit-content;
    margin: 0 0 12px 0;
    background-color:#121214;
    color: #A8FFF9;
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.feature_card .card_content {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.card_content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 0px 20px 20px 20px; 
    gap: 8px; 
}

.details_split_row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    width: 100%;
    align-items: stretch; 
}

.left_details, 
.right_details {
    display: flex;
    flex-direction: column;
    gap: 4px; 
}

.right_details {
    justify-content: flex-end;
}

.details_split_row p {
    margin: 0;
    line-height: 1.45;
}

.card_title {
    font-family: "BebasNeue", sans-serif;
    font-size: 32px;
    line-height: 1;
    color: #121214;
}

.card_media {
    display: flex;
    position: relative;
    padding: 20px 20px 0px 20px; 
}

.content_title {
    margin-top: 0;
    margin: 0;
    font-family: "BebasNeue", sans-serif;
    font-size: 32px;
    color: #121214;
}

.release_date,
.author,
.network_studio,
.rating,
.genre {
    margin: 0;
    font-family: "OpenSans_Regular", sans-serif;
    font-size: 15px;
    line-height: 1.45;
    color: #121214;
}

.note {
    margin: 0;
